# No environment variable is required for a new deployment. The first browser
# setup page stores the public domain and bcrypt admin credential state in
# the persistent volumes. This optional setting selects the prebuilt UI preset.
DSH_UI_PRESET=base

# Optional protection for the first-open setup page. The default open mode has
# no setup-code field; use code only when you will retrieve it from container logs.
DSH_SETUP_PROTECTION=open
