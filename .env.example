# Exact public domain authority. Do not include https:// or a path.
DSH_TRUSTED_HOST=dsh.example.com

# Required only during first initialization. Store the actual value in Coolify
# Secrets or an uncommitted .env file, never in Git.
DSH_ADMIN_USERNAME=admin
DSH_ADMIN_PASSWORD=replace-with-a-long-unique-password

# base is the default. workbench enables dsh-better-sidebar.
DSH_UI_PRESET=base
