{
  admin off
  auto_https off
  grace_period 10s
}

:8080 {
  # Reject every authority except the exact startup value before it can reach
  # either status endpoints or DSH. This mirrors (rather than replaces) DSH's
  # own --trusted-host browser fence.
  @invalid_host not host {$DSH_TRUSTED_HOST}
  respond @invalid_host 421

  # The same official DeepSeek Harness mark is used by setup and the Auth Gate
  # login page. Serve it before DSH's authenticated catch-all handler.
  handle /favicon.svg {
    root * /app/src/assets
    header Cache-Control "no-store"
    file_server
  }

  # Browsers fetch the PWA metadata before authentication. It is static public
  # branding only, so serve it directly instead of producing a noisy 401.
  handle /manifest.webmanifest {
    root * /app/src/assets
    header Cache-Control "no-store"
    header Content-Type "application/manifest+json"
    file_server
  }

  # These endpoints intentionally bypass DSH authentication. They expose only
  # readiness and the locked release tuple, never DSH configuration or logs.
  @status path /healthz /readyz /versionz
  handle @status {
    reverse_proxy 127.0.0.1:9000 {
      transport http {
        versions 1.1
      }
      header_up Host {upstream_hostport}
      header_up -Forwarded
      header_up -X-Forwarded-For
      header_up -X-Forwarded-Host
      header_up -X-Forwarded-Proto
      header_up -X-Real-IP
    }
  }

  # DSH's browser-trust fence validates the public authority supplied at
  # startup through --trusted-host. Preserve the browser Host for that check;
  # changing it to loopback would disable the defense.
  handle {
    reverse_proxy 127.0.0.1:3080 {
      transport http {
        versions 1.1
      }
      header_up Host {http.request.host}
      header_up -Forwarded
      header_up -X-Forwarded-For
      header_up -X-Forwarded-Host
      header_up -X-Forwarded-Proto
      header_up -X-Real-IP
      # `dsh-auth-proxy --mark-proxy` uses this deny-only marker to disable
      # server-native APIs when the browser is presented through localhost.
      # A forged marker can only remove capabilities; it can never grant one.
    }
  }
}
